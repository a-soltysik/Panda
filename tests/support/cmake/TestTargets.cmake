include(GoogleTest)

function(panda_configure_test target)
    cmake_parse_arguments(CONFIG "" "" "HEADERS;INCLUDE_DIRECTORIES" ${ARGN})
    if(CONFIG_UNPARSED_ARGUMENTS OR CONFIG_KEYWORDS_MISSING_VALUES)
        message(FATAL_ERROR "Invalid configuration for test target ${target}")
    endif()
    panda_resolve_files(test_headers "${CMAKE_CURRENT_SOURCE_DIR}" ${CONFIG_HEADERS})
    if(test_headers)
        target_sources(${target} PRIVATE ${test_headers})
    endif()
    if(CONFIG_INCLUDE_DIRECTORIES)
        target_include_directories(${target} PRIVATE ${CONFIG_INCLUDE_DIRECTORIES})
    endif()
    panda_configure_target(${target} ${test_headers})
endfunction()

function(panda_add_test target level)
    cmake_parse_arguments(TEST "VULKAN_INTERNAL" "TIMEOUT"
        "SOURCES;HEADERS;INCLUDE_DIRECTORIES;LIBRARIES;MOCKS" ${ARGN})
    if(TEST_UNPARSED_ARGUMENTS OR TEST_KEYWORDS_MISSING_VALUES OR NOT TEST_SOURCES)
        message(FATAL_ERROR "Invalid arguments for test ${target}")
    endif()
    add_executable(${target} ${TEST_SOURCES})
    set_target_properties(${target} PROPERTIES UNITY_BUILD OFF FOLDER "Panda/Tests/${level}")
    target_link_libraries(${target} PRIVATE ${TEST_LIBRARIES} GTest::gmock_main)
    set(replacements "")
    foreach(mock IN LISTS TEST_MOCKS)
        if(NOT TARGET ${mock})
            message(FATAL_ERROR "Test ${target}: unknown mock target ${mock}")
        endif()
        get_target_property(dependency ${mock} PANDA_REPLACES)
        if(NOT dependency)
            message(FATAL_ERROR "Test ${target}: ${mock} was not declared with panda_add_mock")
        endif()
        if(dependency IN_LIST replacements)
            message(FATAL_ERROR "Test ${target}: multiple mocks replace ${dependency}")
        endif()
        list(APPEND replacements ${dependency})
        # Direct OBJECT dependencies supply definitions before static archives are searched.
        target_link_libraries(${target} PRIVATE ${mock})
    endforeach()
    if(TEST_VULKAN_INTERNAL)
        panda_configure_vulkan_internal(${target})
    endif()
    set(test_configuration "")
    if(TEST_HEADERS)
        list(APPEND test_configuration HEADERS ${TEST_HEADERS})
    endif()
    if(TEST_INCLUDE_DIRECTORIES)
        list(APPEND test_configuration INCLUDE_DIRECTORIES ${TEST_INCLUDE_DIRECTORIES})
    endif()
    panda_configure_test(${target} ${test_configuration})
    set(test_properties LABELS "${level}")
    if(TEST_TIMEOUT)
        list(APPEND test_properties TIMEOUT "${TEST_TIMEOUT}")
    endif()
    gtest_discover_tests(${target}
        TEST_PREFIX "${level}."
        PROPERTIES ${test_properties}
        DISCOVERY_TIMEOUT 15)
endfunction()

function(panda_add_mock target)
    cmake_parse_arguments(MOCK "VULKAN_INTERNAL" "REPLACES;API_LIBRARY"
        "SOURCES;HEADERS;INCLUDE_DIRECTORIES;LIBRARIES" ${ARGN})
    if(MOCK_UNPARSED_ARGUMENTS OR MOCK_KEYWORDS_MISSING_VALUES OR NOT MOCK_SOURCES OR NOT MOCK_REPLACES)
        message(FATAL_ERROR "Invalid arguments for mock ${target}")
    endif()
    if(NOT MOCK_API_LIBRARY)
        set(MOCK_API_LIBRARY "${MOCK_REPLACES}")
    endif()
    if(NOT TARGET "${MOCK_API_LIBRARY}")
        message(FATAL_ERROR "Mock ${target}: unknown API library ${MOCK_API_LIBRARY}")
    endif()
    get_target_property(api_type ${MOCK_API_LIBRARY} TYPE)
    if(api_type STREQUAL "SHARED_LIBRARY")
        message(FATAL_ERROR "Mock ${target}: shared libraries do not support archive-member replacement")
    endif()
    add_library(${target} OBJECT ${MOCK_SOURCES})
    set_target_properties(${target} PROPERTIES UNITY_BUILD OFF FOLDER "Panda/Test support")
    set_property(TARGET ${target} PROPERTY PANDA_REPLACES ${MOCK_REPLACES})
    target_link_libraries(${target} PUBLIC ${MOCK_LIBRARIES} "$<COMPILE_ONLY:${MOCK_API_LIBRARY}>")
    if(MOCK_VULKAN_INTERNAL)
        panda_configure_vulkan_internal(${target})
    endif()
    set(mock_configuration "")
    if(MOCK_HEADERS)
        list(APPEND mock_configuration HEADERS ${MOCK_HEADERS})
    endif()
    if(MOCK_INCLUDE_DIRECTORIES)
        list(APPEND mock_configuration INCLUDE_DIRECTORIES ${MOCK_INCLUDE_DIRECTORIES})
    endif()
    panda_configure_test(${target} ${mock_configuration})
endfunction()
