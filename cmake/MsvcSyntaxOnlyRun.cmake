# Append MSVC syntax-only mode to the compiler command passed by CMake's launcher.
math(EXPR last_argument "${CMAKE_ARGC} - 1")
set(invocation "execute_process(COMMAND")
foreach(index RANGE 4 ${last_argument})
    set(argument "${CMAKE_ARGV${index}}")
    set(delimiter "=")
    while(argument MATCHES "]${delimiter}]")
        string(APPEND delimiter "=")
    endwhile()
    string(APPEND invocation " [${delimiter}[${argument}]${delimiter}]")
endforeach()
string(APPEND invocation " [==[/Zs]==] RESULT_VARIABLE result)")
cmake_language(EVAL CODE "${invocation}")
if(NOT result STREQUAL "0")
    message(FATAL_ERROR "MSVC syntax-only command failed: ${result}")
endif()
