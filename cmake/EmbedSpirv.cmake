if(NOT DEFINED OUTPUT_FILE OR NOT DEFINED SHADER_SPIRV_FILES)
    message(FATAL_ERROR "OUTPUT_FILE and SHADER_SPIRV_FILES are required")
endif()

function(append_shader shader_path)
    get_filename_component(shader_file "${shader_path}" NAME)
    string(REGEX REPLACE "\\.spv$" "" shader_name "${shader_file}")
    if(shader_name MATCHES "\\.vert$")
        string(REGEX REPLACE "\\.vert$" "" shader_name "${shader_name}")
        set(stage_suffix "Vertex")
    elseif(shader_name MATCHES "\\.frag$")
        string(REGEX REPLACE "\\.frag$" "" shader_name "${shader_name}")
        set(stage_suffix "Fragment")
    else()
        message(FATAL_ERROR "Unsupported built-in shader name: ${shader_file}")
    endif()
    string(REPLACE "_" ";" symbol_parts "${shader_name}")
    list(GET symbol_parts 0 symbol_name)
    list(REMOVE_AT symbol_parts 0)
    foreach(part IN LISTS symbol_parts)
        string(SUBSTRING "${part}" 0 1 first_character)
        string(TOUPPER "${first_character}" first_character)
        string(SUBSTRING "${part}" 1 -1 remaining_characters)
        string(APPEND symbol_name "${first_character}${remaining_characters}")
    endforeach()
    string(APPEND symbol_name "${stage_suffix}")

    file(READ "${shader_path}" shader_hex HEX)
    string(LENGTH "${shader_hex}" hex_length)
    math(EXPR remainder "${hex_length} % 8")
    if(hex_length EQUAL 0 OR NOT remainder EQUAL 0)
        message(FATAL_ERROR "${shader_path} is not a nonempty SPIR-V word stream")
    endif()

    math(EXPR word_count "${hex_length} / 8")
    math(EXPR last_word "${word_count} - 1")
    set(words "")
    foreach(index RANGE 0 ${last_word})
        math(EXPR offset "${index} * 8")
        string(SUBSTRING "${shader_hex}" ${offset} 2 byte0)
        math(EXPR byte1_offset "${offset} + 2")
        math(EXPR byte2_offset "${offset} + 4")
        math(EXPR byte3_offset "${offset} + 6")
        string(SUBSTRING "${shader_hex}" ${byte1_offset} 2 byte1)
        string(SUBSTRING "${shader_hex}" ${byte2_offset} 2 byte2)
        string(SUBSTRING "${shader_hex}" ${byte3_offset} 2 byte3)
        string(APPEND words "0x${byte3}${byte2}${byte1}${byte0}U,")
    endforeach()

    file(APPEND "${OUTPUT_FILE}"
         "inline constexpr auto ${symbol_name} = std::to_array<std::uint32_t>({${words}});\n")
endfunction()

file(WRITE "${OUTPUT_FILE}" "#pragma once\n\n#include <array>\n#include <cstdint>\n\nnamespace panda::core::vulkan::renderer::shaders\n{\n")
foreach(shader IN LISTS SHADER_SPIRV_FILES)
    append_shader("${shader}")
endforeach()
file(APPEND "${OUTPUT_FILE}" "}\n")
