function(panda_enable_static_analysis target)
    if((PANDA_ENABLE_CLANG_TIDY OR PANDA_ENABLE_CPPCHECK) AND PANDA_ENABLE_UNITY)
        message(FATAL_ERROR "Panda static analysis requires PANDA_ENABLE_UNITY=OFF")
    endif()
    if(PANDA_ENABLE_CLANG_TIDY)
        find_program(PANDA_CLANG_TIDY_EXECUTABLE NAMES clang-tidy REQUIRED)
        set(clang_tidy ${PANDA_MSVC_LAUNCHER} "${PANDA_CLANG_TIDY_EXECUTABLE}"
            --extra-arg=-Wno-unknown-warning-option "--exclude-header-filter=(^|[/\\\\])(_deps|legacy)[/\\\\]")
        if(MSVC)
            # LLVM tools may be built for MinGW; analyze the actual MSVC ABI instead.
            list(APPEND clang_tidy --extra-arg=--target=x86_64-pc-windows-msvc)
            if(CMAKE_CXX_FLAGS MATCHES "(/EH[^ ]+)")
                list(APPEND clang_tidy "--extra-arg=${CMAKE_MATCH_1}")
            endif()
        endif()
        if(NOT PANDA_SEPARATE_STATIC_ANALYSIS)
            set_property(TARGET ${target} PROPERTY CXX_CLANG_TIDY "${clang_tidy}")
        endif()
    endif()

    if(PANDA_ENABLE_CPPCHECK)
        find_program(PANDA_CPPCHECK_EXECUTABLE NAMES cppcheck REQUIRED)
        get_target_property(panda_cxx_standard ${target} CXX_STANDARD)
        if(NOT panda_cxx_standard)
            set(panda_cxx_standard 23)
        endif()
        set(cppcheck ${PANDA_MSVC_LAUNCHER} "${PANDA_CPPCHECK_EXECUTABLE}"
            --enable=warning,style,performance,portability --error-exitcode=1 --std=c++${panda_cxx_standard} --inline-suppr --quiet)
        if(NOT PANDA_SEPARATE_STATIC_ANALYSIS)
            set_property(TARGET ${target} PROPERTY CXX_CPPCHECK "${cppcheck}")
        endif()
    endif()

    if(PANDA_SEPARATE_STATIC_ANALYSIS AND (clang_tidy OR cppcheck))
        panda_add_static_analysis(${target} "${clang_tidy}" "${cppcheck}")
    endif()
    panda_enable_cuda_static_analysis(${target} "${clang_tidy}")
endfunction()

function(panda_add_static_analysis target clang_tidy cppcheck)
    if(NOT CMAKE_EXPORT_COMPILE_COMMANDS)
        message(FATAL_ERROR "Separate Panda analysis requires CMAKE_EXPORT_COMPILE_COMMANDS=ON")
    endif()
    if(NOT TARGET panda_static_analysis)
        add_custom_target(panda_static_analysis)
        set_target_properties(panda_static_analysis PROPERTIES FOLDER "Panda/Checks")
    endif()
    if(MSVC)
        list(APPEND clang_tidy --extra-arg-before=--driver-mode=cl)
    endif()
    get_target_property(sources ${target} SOURCES)
    get_target_property(source_directory ${target} SOURCE_DIR)
    list(FILTER sources INCLUDE REGEX "\\.(cpp|cc|cxx|c\\+\\+)$")
    foreach(source IN LISTS sources)
        get_filename_component(source "${source}" ABSOLUTE BASE_DIR "${source_directory}")
        # A source can belong to several targets; the database retains all its configurations.
        string(SHA256 source_id "${source}")
        set(check_target "panda_analysis_${source_id}")
        if(TARGET ${check_target})
            continue()
        endif()
        set(commands)
        if(PANDA_ENABLE_CLANG_TIDY)
            list(APPEND commands COMMAND ${clang_tidy} -p "${CMAKE_BINARY_DIR}" "${source}")
        endif()
        if(PANDA_ENABLE_CPPCHECK)
            list(APPEND commands COMMAND ${cppcheck}
                "--project=${CMAKE_BINARY_DIR}/compile_commands.json" "--file-filter=${source}")
        endif()
        add_custom_target(${check_target} ${commands}
            WORKING_DIRECTORY "${PROJECT_SOURCE_DIR}"
            COMMENT "Analyze C++: ${source}" VERBATIM)
        set_target_properties(${check_target} PROPERTIES FOLDER "Panda/Checks")
        add_dependencies(panda_static_analysis ${check_target})
    endforeach()
endfunction()

function(panda_enable_cuda_static_analysis target clang_tidy)
    if(NOT PANDA_ENABLE_CLANG_TIDY OR NOT CMAKE_CUDA_COMPILER_ID STREQUAL "Clang")
        return()
    endif()
    get_target_property(cuda_sources ${target} SOURCES)
    list(FILTER cuda_sources INCLUDE REGEX "\\.cu$")
    if(NOT cuda_sources)
        return()
    endif()
    get_target_property(source_directory ${target} SOURCE_DIR)
    set(sources)
    foreach(source IN LISTS cuda_sources)
        get_filename_component(source "${source}" ABSOLUTE BASE_DIR "${source_directory}")
        list(APPEND sources "${source}")
    endforeach()

    list(APPEND clang_tidy ${PANDA_CUDA_CLANG_TIDY_OPTIONS})
    if(NOT TARGET panda_cuda_analysis)
        add_custom_target(panda_cuda_analysis)
        set_target_properties(panda_cuda_analysis PROPERTIES FOLDER "Panda/Checks")
    endif()
    add_custom_target(${target}_analysis
        COMMAND ${clang_tidy} -p "${CMAKE_BINARY_DIR}" --extra-arg=--cuda-host-only ${sources}
        COMMAND ${clang_tidy} -p "${CMAKE_BINARY_DIR}" --extra-arg=--cuda-device-only ${sources}
        VERBATIM)
    set_target_properties(${target}_analysis PROPERTIES FOLDER "Panda/Checks")
    add_dependencies(panda_cuda_analysis ${target}_analysis)
endfunction()
