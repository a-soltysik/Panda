{
  "version": 6,
  "configurePresets": [
    {
      "name": "docs-checks",
      "displayName": "Panda functional documentation checks",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-docs-checks",
      "cacheVariables": {
        "PANDA_DOCS_ONLY": "ON"
      }
    },
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "PANDA_WARNINGS_AS_ERRORS": "ON",
        "PANDA_ENABLE_CLANG_TIDY": "ON",
        "PANDA_ENABLE_CPPCHECK": "ON",
        "PANDA_ENABLE_CLANG_FORMAT": "ON",
        "PANDA_ENABLE_UNITY": "OFF",
        "PANDA_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "local-base",
      "hidden": true,
      "environment": {
        "CCACHE_DIR": "${sourceDir}/.cache/ccache"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER_LAUNCHER": "ccache",
        "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
        "CMAKE_CUDA_COMPILER_LAUNCHER": "ccache",
        "CMAKE_CUDA_ARCHITECTURES": "native",
        "PANDA_BUILD_TOOLS": "ON",
        "PANDA_BUILD_EXAMPLES": "ON",
        "PANDA_BUILD_BENCHMARKS": "ON",
        "PANDA_BUILD_CUDA": "ON"
      }
    },
    {
      "name": "gcc-base",
      "hidden": true,
      "inherits": "base",
      "binaryDir": "${sourceDir}/build-${presetName}-${hostSystemName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "msvc-base",
      "hidden": true,
      "inherits": "base",
      "binaryDir": "${sourceDir}/build-${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "toolset": {
        "value": "host=x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "gcc-development",
      "displayName": "Panda GCC development build",
      "inherits": "gcc-base",
      "cacheVariables": {
        "PANDA_BUILD_TESTS": "OFF",
        "PANDA_BUILD_TOOLS": "ON",
        "PANDA_BUILD_EXAMPLES": "ON",
        "PANDA_BUILD_CUDA": "OFF",
        "PANDA_ENABLE_CLANG_TIDY": "OFF",
        "PANDA_ENABLE_CPPCHECK": "OFF",
        "PANDA_ENABLE_CLANG_FORMAT": "OFF"
      }
    },
    {
      "name": "gcc-quality",
      "displayName": "Panda GCC quality build",
      "inherits": ["local-base", "gcc-base"],
      "cacheVariables": {
        "PANDA_BUILD_EXAMPLES": "ON",
        "PANDA_BUILD_BENCHMARKS": "ON",
        "PANDA_VERIFY_PUBLIC_HEADERS": "ON"
      }
    },
    {
      "name": "gcc-unity",
      "displayName": "Panda Linux GCC unity build",
      "inherits": ["tests-base", "gcc-base"],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "PANDA_BUILD_TESTS": "OFF",
        "PANDA_BUILD_TOOLS": "ON",
        "PANDA_BUILD_EXAMPLES": "ON",
        "PANDA_ENABLE_UNITY": "ON"
      }
    },
    {
      "name": "gcc-docs",
      "displayName": "Panda Linux API documentation",
      "inherits": ["tests-base", "gcc-base"],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "PANDA_BUILD_TESTS": "OFF",
        "PANDA_BUILD_DOCS": "ON"
      }
    },
    {
      "name": "gcc-coverage",
      "displayName": "Panda Linux GCC coverage",
      "inherits": ["tests-base", "gcc-base"],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "PANDA_ENABLE_COVERAGE": "ON",
        "PANDA_BUILD_TOOLS": "ON",
        "PANDA_BUILD_BENCHMARKS": "ON"
      }
    },
    {
      "name": "msvc-development",
      "displayName": "Panda MSVC development build",
      "inherits": "msvc-base",
      "cacheVariables": {
        "PANDA_BUILD_TESTS": "OFF",
        "PANDA_BUILD_TOOLS": "ON",
        "PANDA_BUILD_EXAMPLES": "ON",
        "PANDA_BUILD_CUDA": "OFF",
        "PANDA_ENABLE_CLANG_TIDY": "OFF",
        "PANDA_ENABLE_CPPCHECK": "OFF",
        "PANDA_ENABLE_CLANG_FORMAT": "OFF"
      }
    },
    {
      "name": "msvc-quality",
      "displayName": "Panda MSVC quality build",
      "inherits": ["local-base", "msvc-base"],
      "cacheVariables": {
        "CMAKE_MSVC_DEBUG_INFORMATION_FORMAT": "Embedded",
        "PANDA_BUILD_EXAMPLES": "ON",
        "PANDA_BUILD_BENCHMARKS": "ON",
        "PANDA_VERIFY_PUBLIC_HEADERS": "ON"
      }
    },
    {
      "name": "msvc-unity",
      "displayName": "Panda Windows MSVC unity build",
      "inherits": ["tests-base", "msvc-base"],
      "cacheVariables": {
        "PANDA_BUILD_TESTS": "OFF",
        "PANDA_BUILD_TOOLS": "ON",
        "PANDA_BUILD_EXAMPLES": "ON",
        "PANDA_ENABLE_UNITY": "ON"
      }
    },
    {
      "name": "gcc-sanitizers",
      "displayName": "Panda Linux GCC Address/UndefinedBehaviorSanitizer build",
      "inherits": [
        "tests-base",
        "gcc-base"
      ],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "PANDA_ENABLE_SANITIZER_ADDRESS": "ON",
        "PANDA_ENABLE_SANITIZER_UNDEFINED_BEHAVIOR": "ON"
      }
    },
    {
      "name": "gcc-thread-sanitizer",
      "displayName": "Panda Linux GCC ThreadSanitizer build",
      "inherits": [
        "tests-base",
        "gcc-base"
      ],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "PANDA_ENABLE_SANITIZER_THREAD": "ON"
      }
    },
    {
      "name": "msvc-sanitizers",
      "displayName": "Panda MSVC AddressSanitizer build",
      "inherits": [
        "tests-base",
        "msvc-base"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "PANDA_ENABLE_SANITIZER_ADDRESS": "ON"
      }
    },
    {
      "name": "tests-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "PANDA_ENABLE_CLANG_TIDY": "OFF",
        "PANDA_ENABLE_CPPCHECK": "OFF",
        "PANDA_ENABLE_CLANG_FORMAT": "OFF"
      }
    },
    {
      "name": "gcc-tests",
      "displayName": "Panda GCC CPU tests",
      "inherits": [
        "tests-base",
        "gcc-base"
      ]
    },
    {
      "name": "msvc-tests",
      "displayName": "Panda MSVC CPU tests",
      "inherits": [
        "tests-base",
        "msvc-base"
      ]
    },
    {
      "name": "clang-tests",
      "displayName": "Panda Linux Clang CPU tests",
      "inherits": "tests-base",
      "binaryDir": "${sourceDir}/build-${presetName}-${hostSystemName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "gcc-fast",
      "displayName": "Panda GCC complete fast build",
      "inherits": ["local-base", "gcc-tests"],
      "cacheVariables": {
        "PANDA_ENABLE_UNITY": "ON"
      }
    },
    {
      "name": "msvc-fast",
      "displayName": "Panda MSVC complete fast build",
      "inherits": ["local-base", "msvc-tests"],
      "cacheVariables": {
        "CMAKE_MSVC_DEBUG_INFORMATION_FORMAT": "Embedded",
        "PANDA_ENABLE_UNITY": "ON"
      }
    },
    {
      "name": "clang-cuda-analysis",
      "displayName": "Panda Clang CUDA analysis",
      "inherits": ["local-base", "base"],
      "binaryDir": "${sourceDir}/build-gcc-quality-${hostSystemName}/cuda",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_CUDA_COMPILER": "clang++",
        "CMAKE_CUDA_ARCHITECTURES": "89",
        "PANDA_CUDA_CLANG_TIDY_OPTIONS": "--extra-arg=-Wno-error=unknown-cuda-version;--warnings-as-errors=-clang-diagnostic-unknown-cuda-version",
        "PANDA_BUILD_CUDA": "ON",
        "PANDA_BUILD_TOOLS": "ON",
        "PANDA_BUILD_EXAMPLES": "ON",
        "PANDA_BUILD_TESTS": "OFF",
        "PANDA_BUILD_BENCHMARKS": "OFF",
        "PANDA_ENABLE_CPPCHECK": "OFF",
        "PANDA_ENABLE_CLANG_FORMAT": "OFF"
      }
    },
    {
      "name": "clang-cuda-analysis-windows",
      "inherits": "clang-cuda-analysis",
      "binaryDir": "${sourceDir}/build-msvc-quality/cuda",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER_TARGET": "x86_64-pc-windows-msvc",
        "CMAKE_CXX_COMPILER_TARGET": "x86_64-pc-windows-msvc",
        "CMAKE_CUDA_COMPILER_TARGET": "x86_64-pc-windows-msvc",
        "CMAKE_CUDA_FLAGS": "--target=x86_64-pc-windows-msvc",
        "CMAKE_LINKER_TYPE": "MSVC"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "gcc-fast",
      "configurePreset": "gcc-fast"
    },
    {
      "name": "msvc-fast",
      "configurePreset": "msvc-fast"
    },
    {
      "name": "docs-checks",
      "configurePreset": "docs-checks",
      "targets": ["panda_check_diagrams"]
    },
    {
      "name": "gcc-unity",
      "configurePreset": "gcc-unity"
    },
    {
      "name": "msvc-unity",
      "configurePreset": "msvc-unity"
    },
    {
      "name": "gcc-docs",
      "configurePreset": "gcc-docs",
      "targets": ["panda_docs"]
    },
    {
      "name": "gcc-coverage",
      "configurePreset": "gcc-coverage"
    },
    {
      "name": "gcc-development",
      "configurePreset": "gcc-development"
    },
    {
      "name": "gcc-quality",
      "configurePreset": "gcc-quality",
      "jobs": 4
    },
    {
      "name": "msvc-development",
      "configurePreset": "msvc-development"
    },
    {
      "name": "msvc-quality",
      "configurePreset": "msvc-quality",
      "jobs": 4
    },
    {
      "name": "gcc-sanitizers",
      "configurePreset": "gcc-sanitizers"
    },
    {
      "name": "gcc-thread-sanitizer",
      "configurePreset": "gcc-thread-sanitizer"
    },
    {
      "name": "msvc-sanitizers",
      "configurePreset": "msvc-sanitizers"
    },
    {
      "name": "gcc-tests",
      "configurePreset": "gcc-tests"
    },
    {
      "name": "msvc-tests",
      "configurePreset": "msvc-tests"
    },
    {
      "name": "clang-tests",
      "configurePreset": "clang-tests"
    },
    {
      "name": "clang-cuda-analysis",
      "configurePreset": "clang-cuda-analysis",
      "targets": [
        "panda_cuda_analysis"
      ]
    },
    {
      "name": "clang-cuda-analysis-windows",
      "configurePreset": "clang-cuda-analysis-windows",
      "targets": [
        "panda_cuda_analysis"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "gcc-fast",
      "inherits": "base",
      "configurePreset": "gcc-fast"
    },
    {
      "name": "msvc-fast",
      "inherits": "base",
      "configurePreset": "msvc-fast"
    },
    {
      "name": "gcc-quality",
      "inherits": "base",
      "configurePreset": "gcc-quality"
    },
    {
      "name": "msvc-quality",
      "inherits": "base",
      "configurePreset": "msvc-quality"
    },
    {
      "name": "gcc-sanitizers",
      "inherits": "base",
      "configurePreset": "gcc-sanitizers",
      "filter": {
        "exclude": {
          "label": "system"
        }
      }
    },
    {
      "name": "gcc-thread-sanitizer",
      "inherits": "base",
      "configurePreset": "gcc-thread-sanitizer",
      "filter": {
        "exclude": {
          "label": "system"
        }
      }
    },
    {
      "name": "msvc-sanitizers",
      "inherits": "base",
      "configurePreset": "msvc-sanitizers",
      "filter": {
        "exclude": {
          "label": "system"
        }
      }
    },
    {
      "name": "gcc-tests",
      "inherits": "base",
      "configurePreset": "gcc-tests",
      "filter": {
        "exclude": {
          "label": "system"
        }
      }
    },
    {
      "name": "gcc-coverage",
      "inherits": "base",
      "configurePreset": "gcc-coverage",
      "filter": {
        "exclude": {
          "label": "system"
        }
      }
    },
    {
      "name": "msvc-tests",
      "inherits": "base",
      "configurePreset": "msvc-tests",
      "filter": {
        "exclude": {
          "label": "system"
        }
      }
    },
    {
      "name": "clang-tests",
      "inherits": "base",
      "configurePreset": "clang-tests",
      "filter": {
        "exclude": {
          "label": "system"
        }
      }
    }
  ]
}
